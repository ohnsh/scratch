---
import 'photoswipe/style.css'
import getICloudAlbum from '@/loaders/icloud'
import { Icon } from '@astrojs/starlight/components'

// photoswipe astro component example:
// https://github.com/jonasfroeller/astro.image.lightbox/blob/main/src/PhotoSwipeImage.astro

interface Props {
  token: string
}

interface Asset {
  url_expiry: string
  url_location: string // keyof locations
  url_path: string
}
interface Location {
  scheme: string
  hosts: string[]
}
interface WebAassetUrls {
  locations: Record<string, Location>
  items: Record<string, Asset> // key is checksum
}
interface Derivative {
  fileSize: string
  checksum: string
  width: string
  state: 'available'
  height: string
}
interface WebStreamMedia {
  batchGuid: string
  derivatives: Record<string, Derivative>
  contributorLastName: string
  batchDateCreated: string
  dateCreated: string
  contributorFirstName: string
  photoGuid: string
  contributorFullName: string
  mediaAssetType?: 'video'
  caption: string
}
interface WebStream {
  userLastName: string
  streamCtag: string
  itemsReturned: string
  locations: any
  userFirstName: string
  streamName: string
  photos: WebStreamMedia[]
}

const { token } = Astro.props
const { webstream, webasseturls } = (await getICloudAlbum(token)) as {
  webstream: WebStream
  webasseturls: WebAassetUrls
}

const photos = webstream.photos
  .filter(({ mediaAssetType = '' }) => mediaAssetType !== 'video')
  .map((photo) => {
    const [largest] = Object.values(photo.derivatives).sort(
      (a, b) => Number(b.width) - Number(a.width)
    )

    return {
      largest,
      type: 'photo',
      created: photo.dateCreated,
      batchCreated: photo.batchDateCreated,
      contributor: photo.contributorFullName,
    }
  })

const videos = webstream.photos
  .filter(({ mediaAssetType = '' }) => mediaAssetType === 'video')
  .map((video) => {
    const poster = video.derivatives.PosterFrame
    const sortedVids = Object.entries(video.derivatives)
      .filter(([key]) => !Number.isNaN(parseInt(key))) // key !== 'PosterFrame')
      .sort(([a], [b]) => parseInt(b) - parseInt(a))
      .map(([, val]) => val)

    const [largest] = sortedVids

    return {
      largest,
      poster,
      type: 'video',
      created: video.dateCreated,
      batchCreated: video.batchDateCreated,
      contributor: video.contributorFullName,
    }
  })

function getAsset(object: Derivative) {
  return webasseturls.items[object.checksum]
}

function getUrl(asset: Asset) {
  const location = webasseturls.locations[asset.url_location]
  const {
    scheme,
    hosts: [host],
  } = location
  return `${scheme}://${host}${asset.url_path}`
}

const { streamName, userFirstName, userLastName } = webstream
---

<h2>{streamName}</h2>

<p>
  {userFirstName}
  {userLastName}
  •
  <a href={`https://www.icloud.com/sharedalbum/#${token}`} target="_blank">View on iCloud</a>
</p>

<div id="gallery">
  {
    photos.map((photo) => {
      const asset = getAsset(photo.largest)
      const src = getUrl(asset)
      const { width, height } = photo.largest
      return (
        <a
          href={src}
          data-pswp-width={width}
          data-pswp-height={height}
          target="_blank"
        >
          <img {src} />
        </a>
      )
    })
  }
  {
    videos.map((video) => {
      const asset = getAsset(video.largest)
      const src = getUrl(asset)

      const posterAsset = getAsset(video.poster)
      const poster = getUrl(posterAsset)

      return (
        <a
          href={src}
          data-pswp-width={video.largest.width}
          data-pswp-height={video.largest.height}
          data-pswp-type="video"
          target="_blank"
        >
          <img src={poster} alt="" />
          <Icon name="seti:video" />
          {/* <video controls {poster} preload="none">
            <source type="video/mp4" {src} />
          </video> */}
        </a>
      )
    })
  }
</div>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox'
  import PhotoSwipeVideoPlugin from '@/vendor/photoswipe-video-plugin.js'

  const lightbox = new PhotoSwipeLightbox({
    gallery: '#gallery',
    children: 'a',
    pswpModule: () => import('photoswipe'),
  })

  const videoPlugin = new PhotoSwipeVideoPlugin(lightbox, {
    // options
  })

  lightbox.init()
</script>

<style>
  div {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    padding-inline: 0.5rem;
    padding-block: 0.5rem;
    margin-inline: auto;
    place-items: center;

    /*md:grid-cols-3*/
    --primary: var(--sl-text);
    --secondary: var(--sl-text);
  }
  a {
    overflow: hidden;
    border: solid 1px var(--primary);
    border-radius: 0.5rem;
    position: relative;

    &:hover {
      border-color: var(--secondary);
    }
  }
  img {
    object-fit: cover;
    /*
    object-cover
    w-full
    grayscale-[80%]
    hover:grayscale-0
    transition
    duration-300
    ease-in-out
    aspect-[3/2]
  */
  }
  /* <Icon> passes class attribute through, meaning scoped styles will work. */
  svg {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 2.5em;
    height: 2.5em;
  }
</style>
